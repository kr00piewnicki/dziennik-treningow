<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="treningi">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="trening" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:positiveInteger"/>
              <xs:element name="data" type="xs:date"/>
              <xs:element name="rodzaj" type="xs:string"/>
              <xs:element name="intensywnosc">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="niska"/>
                    <xs:enumeration value="umiarkowana"/>
                    <xs:enumeration value="wysoka"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="unikalneId">
      <xs:selector xpath="trening"/>
      <xs:field xpath="id"/>
    </xs:unique>
  </xs:element>
</xs:schema>

